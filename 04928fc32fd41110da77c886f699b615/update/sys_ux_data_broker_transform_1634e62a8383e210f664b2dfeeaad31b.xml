    <sys_ux_data_broker_transform action="INSERT_OR_UPDATE">
        <acl_failure_result/>
        <api_name>x_802331_eyva.Get skills for shift workers</api_name>
        <batch_exclude>false</batch_exclude>
        <description>Retrieves a list of skills for each shift worker.</description>
        <mutates_server_data>false</mutates_server_data>
        <name>Get skills for shift workers</name>
        <output_schema/>
        <private>false</private>
        <props>[&#13;
  {&#13;
    "name": "workers",&#13;
    "label": "Workers",&#13;
    "description": "Array of workers",&#13;
    "readOnly": "false",&#13;
    "fieldType": "array",&#13;
    "mandatory": "true",&#13;
    "defaultValue": []&#13;
  }&#13;
]</props>
        <required_translations>[ {
  "message" : "Array of workers",
  "comment" : ""
}, {
  "message" : "Workers",
  "comment" : ""
} ]</required_translations>
        <schema_version>1.0.0</schema_version>
        <script><![CDATA[function transform(input) {
	var eyvaUtils  = new EyvaUtils();
	input.workers.forEach(function(wkr) {
		var workerGr = new GlideRecord('x_802331_eyva_worker');
		workerGr.get(wkr.groupBy[0].value);
		
		// Get worker's skills and other info
		wkr.skills = eyvaUtils.getWorkerSkills(workerGr);
		wkr.age = {
			"value": workerGr.getValue('age'),
			"displayValue": workerGr.getDisplayValue('age')
		};
		wkr.comment = {
			"value": workerGr.getValue('comment'),
			"displayValue": workerGr.getDisplayValue('comment')
		};
		wkr.notes = {
			"value": workerGr.getValue('notes'),
			"displayValue": workerGr.getDisplayValue('notes')
		};
	});

	return input.workers;
}]]></script>
