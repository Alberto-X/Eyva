    <sys_ux_data_broker_transform action="INSERT_OR_UPDATE">
        <acl_failure_result/>
        <api_name>x_802331_eyva.Get skills with associated positions</api_name>
        <batch_exclude>false</batch_exclude>
        <description>Retrieves a list of all skills and the positions associated with each one.</description>
        <mutates_server_data>false</mutates_server_data>
        <name>Get skills with associated positions</name>
        <output_schema/>
        <private>false</private>
        <props/>
        <required_translations>[ ]</required_translations>
        <schema_version>1.0.0</schema_version>
        <script><![CDATA[function transform() {
	var eyvaUtils = new EyvaUtils();
	var skills = {};
	
	eyvaUtils.SKILLS.forEach(skl => {
		skills[skl.name.toLowerCase().replaceAll(' ', '_')] = {
			name: skl.name,
			positions: skl.getPositions()
		};
	});
	return skills;
}]]></script>
